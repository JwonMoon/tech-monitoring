# 로컬 실행용 예시 (GitHub Actions에서는 저장소 시크릿 사용)
SUBJECT=nvidia          # nvidia | autoware  (--subject 로도 지정 가능)
LLM_BACKEND=claude
STAGE1_MODEL=haiku
STAGE2_MODEL=sonnet
TARGET_DATE=
TARGET_DAYS=2
MAX_ARTICLES=0
MAIL_MODE=file
# GitHub 조직 저장소 감시 (선택). 없으면 비로그인 한도(시간당 60회)로 돈다. Actions 는 github.token 자동 사용
GITHUB_TOKEN=
# SEC EDGAR 공시 수집에 필요 (연락처 UA 정책). 비우면 SEC 소스만 건너뜀
CONTACT_EMAIL=
# MAIL_MODE=smtp 일 때만
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_TO=
